# Copy this file to `.env` (same folder) and fill in your real values.
# `.env` itself is git-ignored — never commit real credentials.

# Your Gmail address
GMAIL_USER=youraddress@gmail.com

# A 16-character Gmail "App Password" — NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be turned on for your Google account first.)
GMAIL_APP_PASSWORD=your16charapppassword
