# Copy this file to .env and fill in real values to enable production behavior.
# Leave .env absent (or these vars unset) to stay in dev mode: emails print to
# the console instead of sending, and password-reset returns the token
# directly in the API response for easy local testing.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# The frontend's URL — used to build the link inside password-reset emails.
FRONTEND_URL=http://127.0.0.1:5173

# --- Email (SMTP) ---
# Setting EMAIL_HOST switches on real email delivery automatically.
#
# Example for Gmail SMTP:
#   1. Enable 2-Step Verification on the Gmail account.
#   2. Create an "App Password" at https://myaccount.google.com/apppasswords
#      (a normal Gmail password will NOT work here).
#   3. Fill in the values below with that app password.
#
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# DEFAULT_FROM_EMAIL=your-address@gmail.com
